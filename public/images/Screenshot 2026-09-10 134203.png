<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0a192f" />
      <stop offset="40%" stop-color="#1e3a8a" />
      <stop offset="70%" stop-color="#d97706" />
      <stop offset="90%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <linearGradient id="waterGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0e1e38" />
      <stop offset="100%" stop-color="#060c17" />
    </linearGradient>
    <linearGradient id="truckGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#f8fafc" />
      <stop offset="100%" stop-color="#cbd5e1" />
    </linearGradient>
  </defs>

  <!-- Top Emerald Bar (Height 32) -->
  <rect x="0" y="0" width="1200" height="32" fill="#00df82" />
  <g transform="translate(36, 21)" font-family="system-ui, -apple-system, sans-serif" font-size="11.5" font-weight="600" fill="#064e3b">
    <!-- Pin -->
    <circle cx="6" cy="-4" r="4" fill="none" stroke="#064e3b" stroke-width="1.5" />
    <text x="16" y="0">Unit 507 15 Chatham Rd West Ryde NSW 2114</text>
    <!-- Phone -->
    <text x="320" y="0">📞 +61452653745</text>
    <!-- Email -->
    <text x="440" y="0">✉ info@techtonika-autolink.com</text>
  </g>
  <!-- Socials -->
  <g transform="translate(1080, 21)" font-family="system-ui, -apple-system, sans-serif" font-size="11.5" font-weight="700" fill="#064e3b">
    <text x="0" y="0">f</text>
    <text x="24" y="0">in</text>
  </g>

  <!-- White Header Bar (Height 60) -->
  <rect x="0" y="32" width="1200" height="60" fill="#ffffff" />
  <!-- Techtonika Logo -->
  <g transform="translate(36, 42)">
    <circle cx="18" cy="18" r="14" fill="none" stroke="#00df82" stroke-width="3" />
    <path d="M 12 18 L 24 18 M 18 12 L 18 24" stroke="#0284c7" stroke-width="2" />
    <text x="42" y="24" font-family="system-ui, -apple-system, sans-serif" font-size="16" font-weight="900" fill="#0d9488" letter-spacing="1">TECHTONIKA</text>
  </g>
  <!-- Nav Links -->
  <g transform="translate(420, 68)" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="700" fill="#334155">
    <text x="0" y="0">Tracking Features ▾</text>
    <text x="145" y="0">DASH CAMS ▾</text>
    <text x="260" y="0">Business ▾</text>
    <text x="360" y="0">BLOGS</text>
    <text x="430" y="0">ABOUT US</text>
    <text x="520" y="0">Contact Us</text>
    <text x="615" y="0">🛍 1</text>
    <text x="655" y="0">🔍</text>
  </g>

  <!-- Main Hero Graphic Background (Sky + Australian City Skyline + Fleet) -->
  <rect x="0" y="92" width="1200" height="583" fill="url(#skyGrad)" />

  <!-- Brisbane / Gold Coast Highrise Silhouette -->
  <g fill="#1a2744" opacity="0.85">
    <rect x="620" y="220" width="35" height="180" />
    <rect x="665" y="190" width="40" height="210" />
    <polygon points="685,140 680,190 690,190" fill="#2d3f66" />
    <rect x="715" y="240" width="50" height="160" />
    <rect x="775" y="170" width="45" height="230" />
    <polygon points="797,110 792,170 802,170" fill="#2d3f66" />
    <rect x="830" y="230" width="60" height="170" />
    <rect x="900" y="260" width="45" height="140" />
    <rect x="955" y="210" width="50" height="190" />
    <rect x="1015" y="250" width="70" height="150" />
  </g>

  <!-- Water Surface & Reflection -->
  <rect x="0" y="400" width="1200" height="80" fill="url(#waterGrad)" />
  <ellipse cx="800" cy="405" rx="300" ry="12" fill="#f59e0b" opacity="0.3" />

  <!-- Road & Fleet Vehicles Lineup in Foreground -->
  <rect x="0" y="440" width="1200" height="150" fill="#090d16" />

  <!-- Vehicles (White HiLux Ute, SUV, Sedan, Semi-Truck) -->
  <g transform="translate(680, 360)">
    <!-- Commercial Semi Truck (Right) -->
    <rect x="360" y="30" width="140" height="170" rx="10" fill="#ffffff" />
    <rect x="380" y="50" width="110" height="60" rx="4" fill="#1e293b" />
    <rect x="380" y="130" width="110" height="30" fill="#94a3b8" />
    <circle cx="435" cy="145" r="10" fill="#000000" stroke="#cbd5e1" stroke-width="2" />
    <circle cx="395" cy="175" r="12" fill="#eab308" />
    <circle cx="475" cy="175" r="12" fill="#eab308" />

    <!-- Modern Australian 4x4 Ute (Center Right) -->
    <path d="M 170 120 L 220 70 L 330 70 L 370 120 L 370 180 L 150 180 Z" fill="#f1f5f9" />
    <path d="M 225 75 L 320 75 L 345 115 L 210 115 Z" fill="#0f172a" />
    <circle cx="195" cy="180" r="28" fill="#1e293b" stroke="#64748b" stroke-width="4" />
    <circle cx="330" cy="180" r="28" fill="#1e293b" stroke="#64748b" stroke-width="4" />
    <rect x="150" y="125" width="16" height="14" rx="2" fill="#fef08a" />

    <!-- SUV (Center) -->
    <path d="M 60 130 L 95 90 L 175 90 L 205 130 L 205 180 L 45 180 Z" fill="#94a3b8" />
    <path d="M 100 95 L 170 95 L 190 125 L 90 125 Z" fill="#0f172a" />
    <circle cx="85" cy="180" r="24" fill="#1e293b" stroke="#475569" stroke-width="3" />

    <!-- Sedan (Left) -->
    <path d="M -70 145 L -40 115 L 30 115 L 50 145 L 50 180 L -80 180 Z" fill="#f8fafc" />
    <circle cx="-35" cy="180" r="22" fill="#1e293b" stroke="#475569" stroke-width="3" />
  </g>

  <!-- Dark Gradient Overlay on Left for Hero Typography -->
  <rect x="0" y="92" width="700" height="583" fill="#060c18" opacity="0.88" />

  <!-- Main Hero Text Content -->
  <g transform="translate(48, 170)">
    <!-- Line 1 (White) -->
    <text x="0" y="55" font-family="'Arial Black', Impact, system-ui, sans-serif" font-size="52" font-weight="900" fill="#ffffff" letter-spacing="1.5">
      SMARTER FLEET MANAGEMENT.
    </text>
    <!-- Line 2 (Yellow) -->
    <text x="0" y="120" font-family="'Arial Black', Impact, system-ui, sans-serif" font-size="58" font-weight="900" fill="#ffcc00" letter-spacing="2">
      STRONGER BUSINESS.
    </text>

    <!-- Subtitle -->
    <text x="0" y="175" font-family="system-ui, -apple-system, sans-serif" font-size="18" font-weight="500" fill="#e2e8f0">
      Real-time GPS tracking solutions for vehicles and assets.
    </text>
    <text x="0" y="205" font-family="system-ui, -apple-system, sans-serif" font-size="18" font-weight="500" fill="#cbd5e1">
      Track. Monitor. Optimise. All from one powerful platform.
    </text>
  </g>

  <!-- Carousel Navigation Arrows & Yellow Progress Dash -->
  <path d="M 30 400 L 20 410 L 30 420" stroke="#ffffff" stroke-width="3" fill="none" stroke-linecap="round" />
  <rect x="44" y="408" width="50" height="4" rx="2" fill="#ffcc00" />
  <path d="M 1170 400 L 1180 410 L 1170 420" stroke="#ffffff" stroke-width="3" fill="none" stroke-linecap="round" />

  <!-- Bottom Yellow Feature Icons Row (Height 75) -->
  <rect x="0" y="590" width="1200" height="85" fill="#050a14" />
  <g transform="translate(48, 610)" font-family="system-ui, -apple-system, sans-serif" font-size="10.5" font-weight="800" fill="#ffcc00" letter-spacing="0.5">
    <!-- Item 1 -->
    <g transform="translate(0, 0)">
      <circle cx="16" cy="10" r="8" fill="none" stroke="#ffcc00" stroke-width="2" />
      <text x="34" y="14">LIVE GPS TRACKING</text>
    </g>
    <!-- Item 2 -->
    <g transform="translate(195, 0)">
      <path d="M 6 16 L 12 10 L 18 14 L 26 4" stroke="#ffcc00" stroke-width="2" fill="none" />
      <text x="36" y="14">DETAILED REPORTS</text>
    </g>
    <!-- Item 3 -->
    <g transform="translate(385, 0)">
      <path d="M 14 4 C 10 4, 8 7, 8 12 L 6 15 L 22 15 L 20 12 C 20 7, 18 4, 14 4 Z" stroke="#ffcc00" stroke-width="2" fill="none" />
      <text x="32" y="14">INSTANT ALERTS</text>
    </g>
    <!-- Item 4 -->
    <g transform="translate(565, 0)">
      <path d="M 14 4 L 22 7 L 22 13 C 22 17, 14 20, 14 20 C 14 20, 6 17, 6 13 L 6 7 Z" stroke="#ffcc00" stroke-width="2" fill="none" />
      <text x="32" y="14">DRIVER SAFETY</text>
    </g>
    <!-- Item 5 -->
    <g transform="translate(745, 0)">
      <rect x="8" y="4" width="12" height="16" rx="2" stroke="#ffcc00" stroke-width="2" fill="none" />
      <text x="28" y="14">REDUCE FUEL COSTS</text>
    </g>
    <!-- Item 6 -->
    <g transform="translate(945, 0)">
      <circle cx="14" cy="11" r="7" stroke="#ffcc00" stroke-width="2" fill="none" stroke-dasharray="3,3" />
      <text x="30" y="14">EASY INTEGRATION</text>
    </g>
  </g>
</svg>
