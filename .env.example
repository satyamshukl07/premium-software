# Environment Variables for MEX Operations Suite & Backend

# Database Configuration (Optional: defaults to built-in SQLite if omitted)
# For production PostgreSQL (e.g. Supabase, Neon, Railway, AWS RDS):
DATABASE_URL=

# Administrative Security & Authentication
JWT_SECRET=your-secure-jwt-random-secret-key
ADMIN_EMAIL=admin@mex.com.au
ADMIN_PASSWORD=AdminPass123!

# Email Notifications (Optional: logs to console if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=admin@mex.com.au

# AI Capabilities
GEMINI_API_KEY=

